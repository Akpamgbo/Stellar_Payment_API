      class="-mx-2 sm:mx-0"
    >
      <div
        data-height="300"
        data-testid="responsive-container"
        data-width="100%"
      >
        <div
          data-margin="{"top":8,"right":16,"left":-8,"bottom":8}"
          data-points="7"
          data-testid="bar-chart"
        >
          <div
            data-testid="cartesian-grid"
          />
